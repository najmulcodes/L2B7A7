# Base URL of the CodeRank backend API, INCLUDING its mounted version
# prefix — the backend mounts every route under /api/v1 (see its
# src/app.ts: app.use("/api/v1", v1Router)), so this must end in /api/v1,
# not just the bare host. Used only by the Next.js route handlers under
# src/app/api/* (server-side) — never exposed to the browser.
#
# Right:  BACKEND_API_URL=http://localhost:5000/api/v1
# Wrong:  BACKEND_API_URL=http://localhost:5000
#
# Getting this wrong is the #1 cause of every request failing with
# "Route not found: POST /auth/login" (note the missing /api/v1 in that
# message — that's the tell).
BACKEND_API_URL=http://localhost:5000/api/v1

# Client-side Google Identity Services client ID (only needed if you wire up
# the "Continue with Google" button). Safe to expose — it is a public ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# One-click "Demo Login" buttons on the login page (src/components/auth/
# DemoLoginButtons.tsx). Create one real account per role on your backend
# first (POST /auth/register, then promote the admin one via
# PATCH /admin/users/:id/role since there's no public admin signup), then
# fill these in. A role with no email/password set here just shows a
# disabled button — nothing is hardcoded in source.
#
# These are NEXT_PUBLIC_* (readable in the browser) by design: they're
# throwaway evaluation credentials meant to be handed to evaluators, not
# secrets. Never put a real user's credentials here.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_CANDIDATE_EMAIL=
NEXT_PUBLIC_DEMO_CANDIDATE_PASSWORD=
NEXT_PUBLIC_DEMO_COMPANY_EMAIL=
NEXT_PUBLIC_DEMO_COMPANY_PASSWORD=
